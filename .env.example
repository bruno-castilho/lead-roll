# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). O .env.local não é versionado.

# URL do projeto, ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable ou anon). Vai para o navegador; a segurança
# real fica na RLS do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=